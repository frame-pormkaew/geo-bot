# ===== Discord =====
DISCORD_TOKEN=

# ===== Gemini (เอาจาก https://aistudio.google.com/apikey) =====
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Puck

# ===== Bridge (ต่อกับ Termux) =====
# พอร์ตที่ Replit จะเปิดรอ Termux มาเชื่อมต่อ
BRIDGE_PORT=8080
# รหัสลับต้องตรงกับฝั่ง Termux เป๊ะๆ ห้ามปล่อยว่าง เพราะ URL ของ Replit เดารู้ได้จากคนอื่น
BRIDGE_SECRET=change_this_to_a_long_random_string

# ===== ตัวเลือกเสริม =====
# ถ้าอยากให้ข้อความแชทปกติ (ไม่ใช่เสียง) ถูกส่งเข้าเกมด้วย ให้ตั้งเป็น true
RELAY_TEXT_TO_MC=false
