# ===== เชื่อมไป geo-brain บน Render =====
# ตัวอย่าง: wss://geo-brain.onrender.com
BRAIN_WS_URL=
BRIDGE_SECRET=change_this_to_a_long_random_string

# ===== ต่อเข้าโลก Minecraft (LAN) =====
# ถ้า Termux กับตัวเกมอยู่เครื่องเดียวกัน ใช้ 127.0.0.1 ได้เลย
# ถ้าคนละเครื่องแต่ wifi เดียวกัน ใช้ IP วง LAN ของเครื่องที่ host โลก (เช่น 192.168.1.23)
MC_HOST=127.0.0.1
# พอร์ตของเกม LAN — ค่า default ของ Bedrock คือ 19132 แต่ Play with Friends อาจสุ่มพอร์ตอื่น
# ดูวิธีหาพอร์ตจริงใน README
MC_PORT=19132

# true = ต่อแบบไม่ผ่าน Xbox Live (ใช้ได้เฉพาะบางกรณี ลองก่อนถ้าไม่ผ่านค่อยเปลี่ยนเป็น false)
MC_OFFLINE=true

# ชื่อที่ Geo จะใช้เข้าเกม
BOT_USERNAME=GeoSad0864

# เปิด log แพ็กเก็ตดิบไว้ debug ตอนที่ movement/attack ยังไม่นิ่ง
DEBUG_PACKETS=false
